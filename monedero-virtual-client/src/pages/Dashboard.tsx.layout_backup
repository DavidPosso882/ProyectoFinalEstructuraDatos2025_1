// Datos de ejemplo para el gráfico de gastos
const generateMockSpendingData = () => {
  const categories = ['Alimentación', 'Transporte', 'Entretenimiento', 'Servicios', 'Otros'];
  const data = [];
  
  // Generar datos para los últimos 3 meses
  const endDate = new Date();
  const startDate = new Date();
  startDate.setMonth(startDate.getMonth() - 3);
  
  let currentDate = new Date(startDate);
  
  while (currentDate <= endDate) {
    // Generar entre 1 y 3 transacciones por día
    const transactionsCount = Math.floor(Math.random() * 3) + 1;
    
    for (let i = 0; i < transactionsCount; i++) {
      const category = categories[Math.floor(Math.random() * categories.length)];
      const amount = Math.floor(Math.random() * 100) + 10; // Entre 10 y 110
      
      data.push({
        date: new Date(currentDate),
        amount,
        category
      });
    }
    
    // Avanzar al siguiente día
    currentDate.setDate(currentDate.getDate() + 1);
  }
  
  return data;
};

